# Renga build profiles.
#
# Included from Jamrules right before upstream's DefineDefaultBuildProfiles,
# so fork settings never have to be written into upstream's files
# (DefaultBuildProfiles, the package lists under build/jam/packages, or
# data/launch). Everything Renga adds to an image is in 3rdparty/ce/Jamfile,
# guarded by HAIKU_RENGA_IMAGE.
#
# Profiles:
#
#   renga-raw       plain disk image          generated.x86_64/renga.image
#   renga-anyboot   ISO for CD, USB and UEFI  generated.x86_64/renga-anyboot.iso
#   renga-vmware    VMware disk image         generated.x86_64/renga.vmdk
#
# A "renga-*" profile is a regular (full desktop) build: DefaultBuildProfiles
# only singles out "bootstrap-*", "minimum-*" and "test-*", and everything
# else builds the regular image. On top of that a Renga image gets:
#
#   - the volume label "Renga" (the boot volume's name on the Desktop and
#     in Tracker) instead of "Haiku";
#   - the Techniix package repository configured next to Haiku's and
#     HaikuPorts' (see 3rdparty/ce/Jamfile);
#   - the packages upstream adds to its nightly images only: wpa_supplicant
#     (Wi-Fi with WPA), openssh, openssl3, nano, p7zip, xz_utils, Noto
#     fonts, mandoc, Pe, Vision and the community sound set; and
#     WebPositive, which upstream adds to its release and nightly images;
#   - the packages listed in HAIKU_RENGA_EXTRA_PACKAGES, which a
#     UserBuildConfig can extend. It is empty for now: Lumina joins once its
#     acceptance checklist has passed on real hardware.
#
# The harness keeps using the minimum-* profiles: they boot in a fraction
# of the time and the tests do not need a desktop.

rule DefineRengaBuildProfiles
{
	DefineBuildProfile renga-raw : image : "renga.image" ;
	DefineBuildProfile renga-anyboot : anyboot-image : "renga-anyboot.iso" ;
	DefineBuildProfile renga-vmware : vmware-image : "renga.vmdk" ;

	switch $(HAIKU_BUILD_PROFILE) {
		case "renga-*" : {
			HAIKU_RENGA_IMAGE = 1 ;

			# 3rdparty/ce is only read when this is set (3rdparty/Jamfile).
			HAIKU_INCLUDE_3RDPARTY = 1 ;

			HAIKU_IMAGE_LABEL ?= Renga ;
			HAIKU_ANYBOOT_LABEL ?= Renga ;
			HAIKU_CD_LABEL ?= Renga ;
			HAIKU_MMC_LABEL ?= Renga ;

			HAIKU_RENGA_EXTRA_PACKAGES ?= ;

			# A web browser (F-57): upstream adds WebPositive (and with it
			# HaikuWebKit) only to its release and nightly profiles, so the
			# regular build Renga images are made from had none.
			if $(HAIKU_PACKAGING_ARCHS) in x86_gcc2 x86 x86_64 {
				AddOptionalHaikuImagePackages WebPositive ;
			}
			# The packages upstream's nightly images get on top of a
			# regular build, as upstream lists them (DefaultBuildProfiles,
			# "nightly-*"), without its optional Development and Git.
			# wpa_supplicant above all: without it net_server cannot
			# launch the supplicant, so joining any protected Wi-Fi network
			# failed on Renga images ("Permission denied" from "ifconfig
			# ... join"; found on the maintainer's PC with the in-tree
			# mt7921e, F-34).
			AddHaikuImageSystemPackages
				mandoc
				noto
				openssh
				openssl3
				pe
				sounds_community_default
				vision
				wpa_supplicant
				!gcc2 @{ nano p7zip xz_utils }@
				gcc2 @{
					nano_x86@secondary_x86
					p7zip_x86@secondary_x86
					xz_utils_x86@secondary_x86
				}@
				;
			AddHaikuImageSourcePackages
				nano
				p7zip
				;

			# The compiler, active next to haiku_devel (3rdparty/ce/Jamfile;
			# maintainer, 2026-11-13: early users are porters). The
			# Installer's "Lean install" leaves these out.
			AddHaikuImageSystemPackages
				!gcc2 @{ binutils gcc gmp mpc mpfr }@
				;

			# room for it (HaikuWebKit alone is about 60 MiB), for the
			# nightly packages (about 120 MiB, most of it the Noto fonts)
			# and for what Renga adds; upstream's release images are 800 MiB.
			# 1400 since the development files (haiku_devel, gcc, binutils;
			# about 180 MiB) are part of the image.
			HAIKU_IMAGE_SIZE ?= 1400 ;
		}
	}
}
