SubDir HAIKU_TOP 3rdparty ce ;

# Renga tooling: the automated test harness and its in-guest
# test programs. Upstream's 3rdparty/Jamfile includes this directory only when
# HAIKU_INCLUDE_3RDPARTY is set, so normal builds are not affected at all.
# Nothing is added to an image unless the harness also sets CE_HARNESS.

SubInclude HAIKU_TOP 3rdparty ce tests ;


# A copy of a repository info file with another "priority" line, for
# 3rdparty/ce's own repository configs (see the Renga images below). The
# copy fails the build if the source has no priority line to replace.
actions RengaRepositoryInfoWithPriority
{
	grep -q '^priority ' $(2) || { echo "$(2): no priority line" >&2; exit 1; }
	sed 's/^priority .*/priority $(HAIKU_RENGA_PRIORITY)/' $(2) > $(1)
}

if $(CE_HARNESS) {
	# The guest-side runner and the launch_daemon job that starts it once the
	# boot volumes are mounted. The runner runs the test programs, writes their
	# output to /dev/dprintf (which reaches the host through the serial port)
	# and powers the machine off.
	local guestDir = [ FDirName $(HAIKU_TOP) 3rdparty ce harness guest ] ;
	local runner = <ce-harness>runner.sh ;
	local job = <ce-harness>ce-harness ;
	SEARCH on $(runner) $(job) = $(guestDir) ;
	AddFilesToHaikuImage system non-packaged data ce-harness : $(runner) ;
	AddFilesToHaikuImage system settings launch : $(job) ;

	# Crashing programs are killed instead of waiting for a user to answer
	# debug_server's alert (see the file for details).
	local debugSettings = <ce-harness-debug_server>settings ;
	SEARCH on $(debugSettings) = [ FDirName $(guestDir) debug_server ] ;
	AddFilesToHaikuImage home config settings system debug_server
		: $(debugSettings) ;

	# The minimum images have no sound card drivers but virtio_sound; the
	# driver tests need the USB audio driver there too (the Renga images
	# have it in the system package already).
	if ! $(HAIKU_RENGA_IMAGE) {
		AddDriversToHaikuImage audio hmulti : usb_audio ;
	}
}


if $(HAIKU_RENGA_IMAGE) {
	# Renga images (the renga-* profiles in 3rdparty/ce/build/RengaBuildProfiles).

	# The Techniix package repository, next to Haiku's and HaikuPorts'. Only
	# the configuration goes into the image; the package index is fetched by
	# HaikuDepot or "pkgman refresh" like for any repository added later, so
	# the image never carries a stale copy. repo.info is a copy of
	# x86_64/current/repo.info from github.com/Techniix/haiku-packages and
	# has to be updated if the repository's base URL or identifier changes.
	local repoInfo = <renga-repository-info>Techniix.repo.info ;
	SEARCH on $(repoInfo) = [ FDirName $(HAIKU_TOP) 3rdparty ce repositories ] ;
	local repoConfig = <renga-repository-config>Techniix ;
	MakeLocate $(repoConfig) : $(HAIKU_PACKAGE_REPOSITORIES_DIR_$(HAIKU_PACKAGING_ARCH)) ;
	RepositoryConfig $(repoConfig) : $(repoInfo) ;
	AddFilesToHaikuImage system settings package-repositories
		: $(repoConfig) : Techniix ;

	# Techniix wins over HaikuPorts when both offer a package of the same
	# name. The package solver prefers the repository with the lower
	# configured priority (libsolv gets -1 - priority, and a higher libsolv
	# priority beats a higher version). Haiku and HaikuPorts both come with
	# priority 1, and 0 means "unset" (BRepositoryConfig::kUnsetPriority),
	# so Techniix cannot go lower: HaikuPorts gets 2 instead. Haiku stays at
	# 1, next to Techniix; nothing should override the system packages.
	#
	# Only the configuration changes, not upstream's build rules: this is a
	# copy of HaikuPorts' generated repository info with the new priority,
	# turned into a config by the same rule, and the image definition is
	# pointed at it through the variable it reads the config from. The
	# HaikuPorts cache (the package index) stays upstream's. The minimum
	# images built from the same build directory keep upstream's config,
	# because the Renga config is a separate file.
	HAIKU_RENGA_HAIKUPORTS_PRIORITY ?= 2 ;
	local portsRepository = <repository>HaikuPorts ;
	local portsInfo = <repository-info>HaikuPorts-info ;
	local rengaPortsInfo = <renga-repository-info>HaikuPorts-info ;
	local rengaPortsConfig = <renga-repository-config>HaikuPorts ;
	local rengaRepositoriesDir = [ FDirName
		$(HAIKU_PACKAGE_REPOSITORIES_DIR_$(HAIKU_PACKAGING_ARCH)) renga ] ;
	MakeLocate $(rengaPortsInfo) $(rengaPortsConfig) : $(rengaRepositoriesDir) ;
	Depends $(rengaPortsInfo) : $(portsInfo) ;
	HAIKU_RENGA_PRIORITY on $(rengaPortsInfo)
		= $(HAIKU_RENGA_HAIKUPORTS_PRIORITY) ;
	RengaRepositoryInfoWithPriority $(rengaPortsInfo) : $(portsInfo) ;
	RepositoryConfig $(rengaPortsConfig) : $(rengaPortsInfo)
		: [ on $(portsRepository)
			return $(HAIKU_REPOSITORY_PACKAGES_CHECKSUM_FILE) ] ;
	HAIKU_REPOSITORY_CONFIG_FILE on $(portsRepository) = $(rengaPortsConfig) ;

	if $(HAIKU_RENGA_EXTRA_PACKAGES) {
		AddHaikuImageSystemPackages $(HAIKU_RENGA_EXTRA_PACKAGES) ;
	}
}

