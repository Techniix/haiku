SubDir HAIKU_TOP 3rdparty ce ;

# Renga tooling: the automated test harness and its in-guest
# test programs. Upstream's 3rdparty/Jamfile includes this directory only when
# HAIKU_INCLUDE_3RDPARTY is set, so normal builds are not affected at all.
# Nothing is added to an image unless the harness also sets CE_HARNESS.

SubInclude HAIKU_TOP 3rdparty ce tests ;


# A copy of a repository info file with another "priority" line, for
# 3rdparty/ce's own repository configs (see the Renga images below). The
# copy fails the build if the source has no priority line to replace.
actions RengaRepositoryInfoWithPriority
{
	grep -q '^priority ' $(2) || { echo "$(2): no priority line" >&2; exit 1; }
	sed 's/^priority .*/priority $(HAIKU_RENGA_PRIORITY)/' $(2) > $(1)
}

if $(CE_HARNESS) {
	# The guest-side runner and the launch_daemon job that starts it once the
	# boot volumes are mounted. The runner runs the test programs, writes their
	# output to /dev/dprintf (which reaches the host through the serial port)
	# and powers the machine off.
	local guestDir = [ FDirName $(HAIKU_TOP) 3rdparty ce harness guest ] ;
	local runner = <ce-harness>runner.sh ;
	local job = <ce-harness>ce-harness ;
	SEARCH on $(runner) $(job) = $(guestDir) ;
	AddFilesToHaikuImage system non-packaged data ce-harness : $(runner) ;
	AddFilesToHaikuImage system settings launch : $(job) ;

	# Crashing programs are killed instead of waiting for a user to answer
	# debug_server's alert (see the file for details).
	local debugSettings = <ce-harness-debug_server>settings ;
	SEARCH on $(debugSettings) = [ FDirName $(guestDir) debug_server ] ;
	AddFilesToHaikuImage home config settings system debug_server
		: $(debugSettings) ;

	# Upstream's kdl test driver (src/add-ons/kernel/drivers/misc/kdl.c),
	# which panics when it is read: the crashlog suite's way into the
	# kernel debugger (F-51). Harness images only.
	AddDriversToHaikuImage misc : <driver>kdl ;

	# LinuxKPI_HaikuOS' test driver (written against the Linux API only):
	# matched against QEMU's edu device, which the harness attaches, it
	# tests the LinuxKPI core (linuxkpi suite, F-26). On real hardware it
	# would also match MediaTek cards, so it is in harness images only.
	if $(TARGET_ARCH) = x86_64 {
		AddDriversToHaikuImage net : lkpi_pcitest ;
	}
	# A net80211 driver without a radio, matched against QEMU's
	# pci-testdev: attach, detach and reload of a Wi-Fi driver on
	# freebsd_network and freebsd_wlan (wlan_reload suite). It matches no
	# real hardware, but stays a test driver: harness images only.
	AddDriversToHaikuImage net : fbsd_wlantest ;

	# The minimum images have no sound card drivers but virtio_sound; the
	# driver tests need the USB audio driver there too (the Renga images
	# have it in the system package already).
	if ! $(HAIKU_RENGA_IMAGE) {
		AddDriversToHaikuImage audio hmulti : usb_audio ;
	}
}


if $(HAIKU_RENGA_IMAGE) {
	# Renga images (the renga-* profiles in 3rdparty/ce/build/RengaBuildProfiles).

	# The Renga package repository (Techniix/RengaPorts, roadmap F-45): the
	# ports built for Renga, and Renga's own haiku and haiku_devel builds, so
	# "pkgman install haiku_devel" gets the development files that match the
	# system. Only the configuration goes into the image; the package index
	# is fetched by HaikuDepot or "pkgman refresh" like for any repository
	# added later, so the image never carries a stale copy. Renga.repo.info
	# is a copy of repository/x86_64/repo.info of RengaPorts and has to be
	# updated if the repository's base URL or identifier changes. (It
	# replaces the Techniix repository, whose packages are built for stock
	# Haiku.)
	local repoInfo = <renga-repository-info>Renga.repo.info ;
	SEARCH on $(repoInfo) = [ FDirName $(HAIKU_TOP) 3rdparty ce repositories ] ;
	local repoConfig = <renga-repository-config>Renga ;
	MakeLocate $(repoConfig) : $(HAIKU_PACKAGE_REPOSITORIES_DIR_$(HAIKU_PACKAGING_ARCH)) ;
	RepositoryConfig $(repoConfig) : $(repoInfo) ;
	AddFilesToHaikuImage system settings package-repositories
		: $(repoConfig) : Renga ;

	# Renga wins over HaikuPorts and Haiku when they offer a package of the
	# same name (haiku, haiku_devel, Renga builds of ports). The package
	# solver prefers the repository with the lower configured priority
	# (libsolv gets -1 - priority, and a higher libsolv priority beats a
	# higher version). Haiku and HaikuPorts both come with priority 1, and 0
	# means "unset" (BRepositoryConfig::kUnsetPriority), so Renga cannot go
	# lower: Haiku and HaikuPorts get 2 instead. Without that, a newer hrev
	# in Haiku's nightly repository would replace Renga's system packages on
	# the next update.
	#
	# Only the configuration changes, not upstream's build rules: these are
	# copies of the generated repository infos with the new priority,
	# turned into configs by the same rule, and the image definition is
	# pointed at them through the variable it reads the config from. The
	# caches (the package indexes) stay upstream's. The minimum images
	# built from the same build directory keep upstream's configs, because
	# the Renga configs are separate files.
	# Haiku's own repository gets its priority in
	# 3rdparty/ce/build/RengaRepositories, which the top Jamfile includes
	# after it set that repository up (later than this file).
	local rengaRepositoriesDir = [ FDirName
		$(HAIKU_PACKAGE_REPOSITORIES_DIR_$(HAIKU_PACKAGING_ARCH)) renga ] ;
	HAIKU_RENGA_HAIKUPORTS_PRIORITY ?= 2 ;
	local portsRepository = <repository>HaikuPorts ;
	local portsInfo = <repository-info>HaikuPorts-info ;
	local rengaPortsInfo = <renga-repository-info>HaikuPorts-info ;
	local rengaPortsConfig = <renga-repository-config>HaikuPorts ;
	MakeLocate $(rengaPortsInfo) $(rengaPortsConfig) : $(rengaRepositoriesDir) ;
	Depends $(rengaPortsInfo) : $(portsInfo) ;
	HAIKU_RENGA_PRIORITY on $(rengaPortsInfo)
		= $(HAIKU_RENGA_HAIKUPORTS_PRIORITY) ;
	RengaRepositoryInfoWithPriority $(rengaPortsInfo) : $(portsInfo) ;
	RepositoryConfig $(rengaPortsConfig) : $(rengaPortsInfo)
		: [ on $(portsRepository)
			return $(HAIKU_REPOSITORY_PACKAGES_CHECKSUM_FILE) ] ;
	HAIKU_REPOSITORY_CONFIG_FILE on $(portsRepository) = $(rengaPortsConfig) ;

	if $(HAIKU_RENGA_EXTRA_PACKAGES) {
		AddHaikuImageSystemPackages $(HAIKU_RENGA_EXTRA_PACKAGES) ;
	}

	# Development files, active (maintainer, 2026-11-13: early users are
	# porters): haiku_devel built from this tree, with every Renga header
	# and library, and the compiler (from HaikuPorts, in the profile). The
	# Installer's "Lean install" leaves them out of an installed system.
	AddPackageFilesToHaikuImage system packages : haiku_devel.hpkg
		: nameFromMetaInfo ;
}

