SubDir HAIKU_TOP 3rdparty ce ;

# Renga tooling: the automated test harness and its in-guest
# test programs. Upstream's 3rdparty/Jamfile includes this directory only when
# HAIKU_INCLUDE_3RDPARTY is set, so normal builds are not affected at all.
# Nothing is added to an image unless the harness also sets CE_HARNESS.

SubInclude HAIKU_TOP 3rdparty ce tests ;

if $(CE_HARNESS) {
	# The guest-side runner and the launch_daemon job that starts it once the
	# boot volumes are mounted. The runner runs the test programs, writes their
	# output to /dev/dprintf (which reaches the host through the serial port)
	# and powers the machine off.
	local guestDir = [ FDirName $(HAIKU_TOP) 3rdparty ce harness guest ] ;
	local runner = <ce-harness>runner.sh ;
	local job = <ce-harness>ce-harness ;
	SEARCH on $(runner) $(job) = $(guestDir) ;
	AddFilesToHaikuImage system non-packaged data ce-harness : $(runner) ;
	AddFilesToHaikuImage system settings launch : $(job) ;

	# Crashing programs are killed instead of waiting for a user to answer
	# debug_server's alert (see the file for details).
	local debugSettings = <ce-harness-debug_server>settings ;
	SEARCH on $(debugSettings) = [ FDirName $(guestDir) debug_server ] ;
	AddFilesToHaikuImage home config settings system debug_server
		: $(debugSettings) ;
}


if $(HAIKU_RENGA_IMAGE) {
	# Renga images (the renga-* profiles in 3rdparty/ce/build/RengaBuildProfiles).

	# The Techniix package repository, next to Haiku's and HaikuPorts'. Only
	# the configuration goes into the image; the package index is fetched by
	# HaikuDepot or "pkgman refresh" like for any repository added later, so
	# the image never carries a stale copy. repo.info is a copy of
	# x86_64/current/repo.info from github.com/Techniix/haiku-packages and
	# has to be updated if the repository's base URL or identifier changes.
	local repoInfo = <renga-repository-info>Techniix.repo.info ;
	SEARCH on $(repoInfo) = [ FDirName $(HAIKU_TOP) 3rdparty ce repositories ] ;
	local repoConfig = <renga-repository-config>Techniix ;
	MakeLocate $(repoConfig) : $(HAIKU_PACKAGE_REPOSITORIES_DIR_$(HAIKU_PACKAGING_ARCH)) ;
	RepositoryConfig $(repoConfig) : $(repoInfo) ;
	AddFilesToHaikuImage system settings package-repositories
		: $(repoConfig) : Techniix ;

	if $(HAIKU_RENGA_EXTRA_PACKAGES) {
		AddHaikuImageSystemPackages $(HAIKU_RENGA_EXTRA_PACKAGES) ;
	}
}
