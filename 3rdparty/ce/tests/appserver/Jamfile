SubDir HAIKU_TOP 3rdparty ce tests appserver ;

# Passing descriptors from applications to app_server (F-58, the Quasar
# driver's R-1 prerequisite), see the source.
UsePrivateHeaders app interface shared ;
ObjectHdrs [ FGristFiles appserver_fd_test$(SUFOBJ) ]
	: [ FDirName $(HAIKU_TOP) headers compatibility gnu ] ;
Application appserver_fd_test :
	appserver_fd_test.cpp
	: be libgnu.so [ TargetLibstdc++ ]
;

# Drag bitmaps with a hardware cursor (F-59), through app_server's
# stand-in hardware cursor, see the source.
Application hw_cursor_test :
	hw_cursor_test.cpp
	: be [ TargetLibstdc++ ]
;

# Reading the screen without the front buffer (F-59), see the source.
Application screen_read_test :
	screen_read_test.cpp
	: be [ TargetLibstdc++ ]
;
# Hide from capture and streamer mode (batch 5), see the source.
Application capture_privacy_test :
	capture_privacy_test.cpp
	: be [ TargetLibstdc++ ]
;

# its direct window (libgame), started by the test where libgame exists
Application screen_read_direct :
	screen_read_direct.cpp
	: be game [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests : appserver_fd_test
		hw_cursor_test screen_read_test capture_privacy_test ;
	AddFilesToHaikuImage system non-packaged bin : screen_read_direct ;
}

# Screen -> Displays (batch 4), the page from the Screen preferences'
# sources, see the source.
local screenPrefsDir = [ FDirName $(HAIKU_TOP) src preferences screen ] ;
ObjectHdrs [ FGristFiles displays_ui_test$(SUFOBJ) DisplaysView$(SUFOBJ)
		WaylandSwitch$(SUFOBJ) displays_multi_test$(SUFOBJ) ]
	: $(screenPrefsDir) ;
SEARCH_SOURCE += $(screenPrefsDir) ;
Application displays_ui_test :
	displays_ui_test.cpp
	DisplaysView.cpp
	WaylandSwitch.cpp
	: be localestub [ TargetLibstdc++ ]
;

# Several screens through <MultiHead.h> version 2 (batch 6), with
# ce-test.py --displays 2; see the source.
Application displays_multi_test :
	displays_multi_test.cpp
	DisplaysView.cpp
	WaylandSwitch.cpp
	: be localestub [ TargetLibstdc++ ]
;
if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests
		: displays_ui_test displays_multi_test ;
}
