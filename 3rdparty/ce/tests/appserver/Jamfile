SubDir HAIKU_TOP 3rdparty ce tests appserver ;

# Passing descriptors from applications to app_server (F-58, the Quasar
# driver's R-1 prerequisite), see the source.
UsePrivateHeaders app interface ;
ObjectHdrs [ FGristFiles appserver_fd_test$(SUFOBJ) ]
	: [ FDirName $(HAIKU_TOP) headers compatibility gnu ] ;
Application appserver_fd_test :
	appserver_fd_test.cpp
	: be libgnu.so [ TargetLibstdc++ ]
;

# Drag bitmaps with a hardware cursor (F-59), through app_server's
# stand-in hardware cursor, see the source.
Application hw_cursor_test :
	hw_cursor_test.cpp
	: be [ TargetLibstdc++ ]
;

# Reading the screen without the front buffer (F-59), see the source.
Application screen_read_test :
	screen_read_test.cpp
	: be [ TargetLibstdc++ ]
;
# its direct window (libgame), started by the test where libgame exists
Application screen_read_direct :
	screen_read_direct.cpp
	: be game [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests : appserver_fd_test
		hw_cursor_test screen_read_test ;
	AddFilesToHaikuImage system non-packaged bin : screen_read_direct ;
}
