SubDir HAIKU_TOP 3rdparty ce tests wifi ;

# Wi-Fi without a Wi-Fi card (F-34): the network list grouped by name
# (WirelessNetworkGroups.h, used by NetworkStatus and the Network
# preferences), on Renga images wpa_supplicant being there, and the
# Deskbar network icon (NetworkStatusIcon.h, NetworkConnectivity.h).
UsePrivateHeaders net ;
Application wifi_test :
	wifi_test.cpp
	: be bnetapi $(TARGET_NETWORK_LIBS) [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests : wifi_test ;
}
