SubDir HAIKU_TOP 3rdparty ce tests storage ;

# DriveSetup's verified image writer (roadmap a04ee0f6), built from its
# source, see image_writer_test.cpp.
UsePrivateHeaders storage ;
local driveSetupDir = [ FDirName $(HAIKU_TOP) src apps drivesetup ] ;
ObjectHdrs [ FGristFiles image_writer_test$(SUFOBJ) ImageWriter$(SUFOBJ) ]
	: $(driveSetupDir) ;
SEARCH_SOURCE += $(driveSetupDir) ;

Application image_writer_test :
	image_writer_test.cpp
	ImageWriter.cpp
	: be [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests
		: image_writer_test ;
}

# Renga's shared disk-management engine (F-24, first part) through
# rengadisk, on a disk image file only. rengadisk itself is put into the
# harness image here (the regular images get it from build/jam).
Application disk_engine_test :
	disk_engine_test.cpp
	: be [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests
		: disk_engine_test ;
	AddFilesToHaikuImage system non-packaged bin : rengadisk ;
}
