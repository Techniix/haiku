SubDir HAIKU_TOP 3rdparty ce tests media ;

UsePrivateHeaders app interface media ;

# Runs in the harness's second phase, with media_server started (see
# harness/guest/runner.sh), hence its own directory.
Application media_test :
	media_test.cpp
	: be media [ TargetLibstdc++ ]
;

# The Audio preferences (F-32): every page, every control against what it
# changes (loopback recordings, the mixer, the default devices, hot-plug).
Application media_sound_test :
	media_sound_test.cpp
	: be media [ TargetLibstdc++ ]
;

# Screenshots of the per-application audio controls (desktop images).
Application media_ui_test :
	media_ui_test.cpp
	: be media [ TargetLibstdc++ ]
;

# Hot-plugging QEMU's usb-audio device with the media services running.
Application media_usb_test :
	media_usb_test.cpp
	: be media [ TargetLibstdc++ ]
;

# Camera selection and preview: CodyCam's Camera menu with the synthetic
# video source (video_producer_demo).
Application media_video_test :
	media_video_test.cpp
	: be media [ TargetLibstdc++ ]
;

# Screen capture (F-31 phase 3) and screen recording in Screenshot (F-44).
Application screen_capture_test :
	screen_capture_test.cpp
	: be media [ TargetLibstdc++ ]
;

# The encode/decode API (F-31 phase 4) and the FFmpeg plug-in's encoders.
Application media_codec_test :
	media_codec_test.cpp
	: be media [ TargetLibstdc++ ]
;

# Streaming through the FFmpeg plug-in's protocols (F-31 phase 4): HLS over
# HTTP, UDP and RTP output, the capture session's stream output.
# Its RTMP check runs FFmpeg's RTMP protocol as the server (listen mode),
# hence libavformat.
UseBuildFeatureHeaders ffmpeg ;
Includes [ FGristFiles media_stream_test.cpp ]
	: [ BuildFeatureAttribute ffmpeg : headers ] ;
SubDirC++Flags -D__STDC_CONSTANT_MACROS ;
Application media_stream_test :
	media_stream_test.cpp
	: be media network [ BuildFeatureAttribute ffmpeg : libraries ]
		[ TargetLibstdc++ ]
;

# Hardware video plumbing (F-31 phase 5) with the "software" reference
# back end of the video acceleration interface.
Application media_hwvideo_test :
	media_hwvideo_test.cpp
	: be media [ TargetLibstdc++ ]
;

# Resampling quality (F-31): THD+N of 44.1 kHz tones mixed at 48 kHz for
# each of the mixer's resampling algorithms.
Application media_resample_test :
	media_resample_test.cpp
	: be media [ TargetLibstdc++ ]
;

# Clock-drift correction of mixer sinks (F-31), with multi_audio's clock
# skew test hook.
Application media_drift_test :
	media_drift_test.cpp
	: be media [ TargetLibstdc++ ]
;

# HTML5 audio and video in WebPositive through the Media Kit (F-57). It
# moves the MP4 clip's index to the front with libavformat ("faststart", as
# MP4 files on the web are), hence FFmpeg.
Includes [ FGristFiles media_html5_test.cpp ]
	: [ BuildFeatureAttribute ffmpeg : headers ] ;
Application media_html5_test :
	media_html5_test.cpp
	: be media network bnetapi [ BuildFeatureAttribute ffmpeg : libraries ]
		[ TargetLibstdc++ ]
;

# The low-latency audio mode (F-31): BSoundPlayer buffers, the mixer's
# switch, the default output's period, latency and steadiness.
Application sound_latency_test :
	sound_latency_test.cpp
	: be media [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests-media
		: media_test media_sound_test media_ui_test media_usb_test
		media_video_test
		screen_capture_test sound_latency_test media_codec_test
		media_stream_test media_hwvideo_test media_resample_test
		media_drift_test media_html5_test ;
}
