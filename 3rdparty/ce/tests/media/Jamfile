SubDir HAIKU_TOP 3rdparty ce tests media ;

UsePrivateHeaders media ;

# Runs in the harness's second phase, with media_server started (see
# harness/guest/runner.sh), hence its own directory.
Application media_test :
	media_test.cpp
	: be media [ TargetLibstdc++ ]
;

# Screenshots of the per-application audio controls (desktop images).
Application media_ui_test :
	media_ui_test.cpp
	: be media [ TargetLibstdc++ ]
;

# Hot-plugging QEMU's usb-audio device with the media services running.
Application media_usb_test :
	media_usb_test.cpp
	: be media [ TargetLibstdc++ ]
;

# Camera selection and preview: CodyCam's Camera menu with the synthetic
# video source (video_producer_demo).
Application media_video_test :
	media_video_test.cpp
	: be media [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests-media
		: media_test media_ui_test media_usb_test media_video_test ;
}
