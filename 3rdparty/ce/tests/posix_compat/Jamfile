SubDir HAIKU_TOP 3rdparty ce tests posix_compat ;

# Conformance tests for the POSIX/Linux compatibility APIs (libgnu and the
# kernel objects behind them).

UseHeaders [ FDirName $(HAIKU_TOP) headers compatibility gnu ] : true ;
UseHeaders [ FDirName $(HAIKU_TOP) headers compatibility bsd ] : true ;
	# getpeereid() (libbsd)

# epoll; uses eventfd and timerfd as event sources.
Application epoll_test :
	epoll_test.cpp
	: libgnu.so network
;

# inotify; also uses epoll and fs_write_attr() (libroot).
# getdents64()/getdents() are in libgnu.
Application getdents_test :
	getdents_test.cpp
	: libgnu.so network [ TargetLibstdc++ ]
;

# getpeereid() (libbsd), POLLRDHUP/EPOLLRDHUP on stream sockets.
Application socket_ext_test :
	socket_ext_test.cpp
	: libbsd.so libgnu.so network
;

Application inotify_test :
	inotify_test.cpp
	: libgnu.so [ TargetLibstdc++ ]
;

# CPU affinity is in libroot (moved from libgnu); deliberately no libgnu.
Application affinity_test :
	affinity_test.cpp
;

Application eventfd_test :
	eventfd_test.cpp
	: libgnu.so
;

Application memfd_test :
	memfd_test.cpp
	: libgnu.so network
;

# SOCK_SEQPACKET UNIX sockets with SCM_RIGHTS (F-58, OBS Studio's O-13).
Application seqpacket_test :
	seqpacket_test.cpp
	: libgnu.so network
;

# getrandom/getauxval/backtrace/copy_file_range are in libgnu,
# sendmmsg/recvmmsg in libnetwork.
Application libc_ext_test :
	libc_ext_test.cpp
	: libgnu.so libnetwork.so
;

# POSIX message queues live in libroot; no libgnu needed.
Application mqueue_test :
	mqueue_test.cpp
;

# System V shared memory lives in libroot too.
Application shm_test :
	shm_test.cpp
;

# getcontext/makecontext/swapcontext live in libroot.
Application ucontext_test :
	ucontext_test.cpp
;

# How TCP connections end (orderly and abortive close).
Application tcp_close_test :
	tcp_close_test.cpp
	: network
;

# The UDP socket options and control messages QUIC uses.
Application quic_udp_test :
	quic_udp_test.cpp
	: network
;

# TCP_INFO.
Application tcp_info_test :
	tcp_info_test.cpp
	: network
;

# TCP keepalive is kernel-side; only the socket calls are needed.
Application tcp_keepalive_test :
	tcp_keepalive_test.cpp
	: network
;

# signalfd; also uses epoll and eventfd.
Application signalfd_test :
	signalfd_test.cpp
	: libgnu.so
;

# __cxa_thread_atexit_impl() is in libroot.
Application thread_atexit_test :
	thread_atexit_test.cpp
;

# Memory semantics V8 and PartitionAlloc rely on (kernel VM only).
Application vm_semantics_test :
	vm_semantics_test.cpp
;

# User-level reader/writer locks after a signal: libroot's rw_lock,
# pthread_rwlock_t (libroot) and RWLockManager (libshared).
UsePrivateHeaders shared ;
Application user_locks_test :
	user_locks_test.cpp
	: be shared [ TargetLibstdc++ ] [ TargetLibsupc++ ]
;

Application timerfd_test :
	timerfd_test.cpp
	: libgnu.so
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests : affinity_test epoll_test eventfd_test getdents_test inotify_test libc_ext_test memfd_test seqpacket_test
		mqueue_test quic_udp_test shm_test signalfd_test socket_ext_test tcp_close_test tcp_info_test tcp_keepalive_test thread_atexit_test timerfd_test ucontext_test user_locks_test vm_semantics_test ;
}
