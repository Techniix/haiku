SubDir HAIKU_TOP 3rdparty ce tests posix_compat ;

# Conformance tests for the POSIX/Linux compatibility APIs (libgnu and the
# kernel objects behind them).

UseHeaders [ FDirName $(HAIKU_TOP) headers compatibility gnu ] : true ;

# epoll; uses eventfd and timerfd as event sources.
Application epoll_test :
	epoll_test.cpp
	: libgnu.so network
;

Application eventfd_test :
	eventfd_test.cpp
	: libgnu.so
;

Application memfd_test :
	memfd_test.cpp
	: libgnu.so network
;

# getrandom/getauxval/backtrace/copy_file_range are in libgnu,
# sendmmsg/recvmmsg in libnetwork.
Application libc_ext_test :
	libc_ext_test.cpp
	: libgnu.so libnetwork.so
;

# POSIX message queues live in libroot; no libgnu needed.
Application mqueue_test :
	mqueue_test.cpp
;

# System V shared memory lives in libroot too.
Application shm_test :
	shm_test.cpp
;

# getcontext/makecontext/swapcontext live in libroot.
Application ucontext_test :
	ucontext_test.cpp
;

# How TCP connections end (orderly and abortive close).
Application tcp_close_test :
	tcp_close_test.cpp
	: network
;

# TCP_INFO.
Application tcp_info_test :
	tcp_info_test.cpp
	: network
;

# TCP keepalive is kernel-side; only the socket calls are needed.
Application tcp_keepalive_test :
	tcp_keepalive_test.cpp
	: network
;

Application timerfd_test :
	timerfd_test.cpp
	: libgnu.so
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests : epoll_test eventfd_test libc_ext_test memfd_test
		mqueue_test shm_test tcp_close_test tcp_info_test tcp_keepalive_test timerfd_test ucontext_test ;
}
