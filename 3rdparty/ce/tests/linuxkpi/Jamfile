SubDir HAIKU_TOP 3rdparty ce tests linuxkpi ;

# The LinuxKPI core (F-26) against QEMU's edu device, through the
# lkpi_pcitest driver (see the source). Harness images also get the driver
# (3rdparty/ce/Jamfile); the harness attaches the device.
Application linuxkpi_test :
	linuxkpi_test.cpp
	: [ TargetLibstdc++ ]
;

# Attaching, detaching and reloading a Wi-Fi driver on freebsd_network and
# freebsd_wlan (fbsd_wlantest on QEMU's pci-testdev, see the source).
Application wlan_reload_test :
	wlan_reload_test.cpp
	: [ TargetLibstdc++ ]
;

# The choice between a system driver and an older non-packaged copy.
UsePrivateHeaders shared ;
Application driver_override_test :
	driver_override_test.cpp
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests : linuxkpi_test
		wlan_reload_test driver_override_test ;
}

# lkpictl, LinuxKPI Manager and the System logs integration, with
# screenshots; needs the desktop of the renga-* images (second phase).
UsePrivateHeaders app interface shared ;
Application linuxkpi_ui_test :
	linuxkpi_ui_test.cpp
	: be [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests-media
		: linuxkpi_ui_test ;
}
