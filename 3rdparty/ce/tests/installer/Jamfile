SubDir HAIKU_TOP 3rdparty ce tests installer ;

UsePrivateHeaders shared storage ;

# The Installer's in-place replacement of an existing installation (F-23):
# upgrade, replace and erase on scratch disks the harness prepares
# (ce-test.py --installer-upgrade), then checks after booting the upgraded
# disk and its old package state. Without those disks it reports nothing.
Application installer_test :
	installer_test.cpp
	: be [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests : installer_test ;
}

# The Installer's window with a destination that has an installation, and
# the installation mode window (renga-* images, with a desktop).
Application installer_ui_test :
	installer_ui_test.cpp
	: be [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests-media
		: installer_ui_test ;
}
