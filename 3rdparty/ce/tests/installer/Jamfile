SubDir HAIKU_TOP 3rdparty ce tests installer ;

UsePrivateHeaders shared storage ;

# The Installer's in-place replacement of an existing installation (F-23):
# upgrade, replace and erase on scratch disks the harness prepares
# (ce-test.py --installer-upgrade), then checks after booting the upgraded
# disk and its old package state. Without those disks it reports nothing.
Application installer_test :
	installer_test.cpp
	: be [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests : installer_test ;
}

# The Installer's window with a destination that has an installation, and
# the installation mode window (renga-* images, with a desktop).
Application installer_ui_test :
	installer_ui_test.cpp
	: be [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests-media
		: installer_ui_test ;
}

# The Destination layouts planned for the Installer's wizard, on the shared
# disk engine (batch 14, F-23), through the command line only so far:
# "Installer --plan-disk" on disk image files on the harness's spare disk
# (ce-test.py SPARE_DISK; erase, free, refusals), then an installation
# onto the new volume.
UsePrivateHeaders diskengine ;
Application installer_destination_test :
	installer_destination_test.cpp
	: be libdiskengine.a [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests
		: installer_destination_test ;
}

# The Installer's wizard end to end (batch 14, F-23): an erase installation
# by the wizard's window (--auto) onto the harness's wizard disk
# (ce-test.py WIZARD_DISK), which the harness then boots with UEFI; this
# test checks that boot too. renga-* images (a desktop).
Application installer_wizard_test :
	installer_wizard_test.cpp
	: be libdiskengine.a [ TargetLibstdc++ ]
;

if $(CE_HARNESS) {
	AddFilesToHaikuImage system non-packaged bin ce-tests-media
		: installer_wizard_test ;
}
