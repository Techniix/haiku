SubDir HAIKU_TOP 3rdparty ce tests renguin ;

# Renguin (roadmap F-27): Linux programs run by the renguin personality.
# The Linux test programs (linux/, from Techniix/Renguin's tests/linux/poc)
# are built here with the build host's own compiler, which on the harness
# host is a Linux x86-64 gcc, so no prebuilt binaries are kept in the tree:
#  - the raw ones use no C library (-nostdlib); they carry no Linux marker,
#    so the action sets EI_OSABI to 3 (ELFOSABI_LINUX), as FreeBSD's
#    brandelf does; Linux ignores the byte;
#  - the libc ones are static glibc programs (the host's libc.a), which
#    glibc brands itself (an NT_GNU_ABI_TAG note). They exist only inside
#    harness images, which are never distributed.
# renguin_test (in Haiku) runs them and compares with linux/expected.txt.

local linuxDir = [ FDirName $(SUBDIR) linux ] ;
local outputDir = [ FDirName $(HAIKU_OUTPUT_DIR) ce-renguin-tests ] ;

RENGUIN_RAW_FLAGS = -O2 -ffreestanding -fno-stack-protector -fno-pie
	-nostdlib -static -no-pie -Wl,--build-id=none ;

actions BuildRenguinRawProgram
{
	$(HOST_CC) $(RENGUIN_RAW_FLAGS) -I$(2:D) -o $(1) $(2)
	printf '\003' | dd of=$(1) bs=1 seek=7 conv=notrunc status=none
}

actions BuildRenguinLibcProgram
{
	$(HOST_CC) -O2 $(RENGUIN_LIBC_FLAGS) -o $(1) $(2)
}

rule RenguinLinuxProgram name : source : kind : flags
{
	local target = <renguin-linux>$(name) ;
	local sourceFile = <renguin-linux-src>$(source) ;
	SEARCH on $(sourceFile) = $(linuxDir) ;
	MakeLocate $(target) : $(outputDir) ;
	Depends $(target) : $(sourceFile) ;
	if $(kind) = raw {
		Depends $(target) : <renguin-linux-src>sys.h ;
		BuildRenguinRawProgram $(target) : $(sourceFile) ;
	} else {
		RENGUIN_LIBC_FLAGS on $(target) = $(flags) ;
		BuildRenguinLibcProgram $(target) : $(sourceFile) ;
	}
	return $(target) ;
}

SEARCH on <renguin-linux-src>sys.h = $(linuxDir) ;

local programs ;
for name in hello ebadf enosys exit xmm {
	programs += [ RenguinLinuxProgram $(name) : $(name).S : raw ] ;
}
for name in args mem fileio ids proc threads signals segv {
	programs += [ RenguinLinuxProgram $(name) : $(name).c : raw ] ;
}
programs += [ RenguinLinuxProgram libc : libc.c : libc : -static ] ;
programs += [ RenguinLinuxProgram libc-pie : libc.c : libc
	: -static-pie -fPIE ] ;
programs += [ RenguinLinuxProgram libc-procfs : libc-procfs.c : libc
	: -static ] ;
# waitid() and close_range() (batch 4, COVERAGE.md's next calls).
programs += [ RenguinLinuxProgram libc-wait : libc-wait.c : libc
	: -static ] ;
# DRM sync objects passed through (Quasar R-18).
programs += [ RenguinLinuxProgram libc-syncobj : libc-syncobj.c : libc
	: -static ] ;
programs += [ RenguinLinuxProgram libc-unix : libc-unix.c : libc
	: -static ] ;
programs += [ RenguinLinuxProgram libc-vdso : libc-vdso.c : libc
	: -static ] ;
programs += [ RenguinLinuxProgram libc-evdev : libc-evdev.c : libc
	: -static ] ;
programs += [ RenguinLinuxProgram libc-xattr : libc-xattr.c : libc
	: -static ] ;
# IPv4-mapped IPv6 addresses (batch 11).
programs += [ RenguinLinuxProgram libc-dualstack : libc-dualstack.c : libc
	: -static ] ;
# Growing a mapped memfd, as Wayland shm pools do (batch 11).
programs += [ RenguinLinuxProgram libc-memgrow : libc-memgrow.c : libc
	: -static ] ;
# Hard links as copies on BFS (batch 11).
programs += [ RenguinLinuxProgram libc-link : libc-link.c : libc
	: -static ] ;
# not run by renguin_test: linux_apps_test makes an AppImage of it
programs += [ RenguinLinuxProgram appimage-fake : appimage-fake.c : libc
	: -static ] ;
for name in pthread libc-signals libc-fs libc-ipc libc-pshared {
	programs += [ RenguinLinuxProgram $(name) : $(name).c : libc
		: -static -pthread ] ;
}

# The Linux root for dynamic programs: Alpine's minirootfs with GNU
# coreutils, the test programs in dyn/ linked against musl and the build
# host's glibc (root/build-root.sh, which documents it). The pinned Alpine
# files are downloaded into the download directory once. The archive is
# extracted into the image's /boot/system/non-packaged/compat/linux, where
# Renguin looks for the Linux root (RENGUIN_LINUX_ROOT).
local rootDir = [ FDirName $(SUBDIR) root ] ;
local dynDir = [ FDirName $(SUBDIR) dyn ] ;
local linuxRoot = <renguin-linux>renguin-linux-root.tar.gz ;
MakeLocate $(linuxRoot) : $(outputDir) ;
local rootInputs = <renguin-root>build-root.sh <renguin-root>alpine.pins ;
SEARCH on $(rootInputs) = $(rootDir) ;
local dynSources = <renguin-dyn>hello.c <renguin-dyn>net.c <renguin-dyn>fds.c
	<renguin-dyn>sys.c ;
SEARCH on $(dynSources) = $(dynDir) ;
local waylandClientDir = [ FDirName $(SUBDIR) dyn-wayland ] ;
local waylandClientSources = <renguin-dyn-wayland>wlclient.c ;
SEARCH on $(waylandClientSources) = $(waylandClientDir) ;
Depends $(linuxRoot) : $(rootInputs) $(dynSources) $(waylandClientSources)
	<build>wayland_scanner ;
RENGUIN_DYN_DIR on $(linuxRoot) = $(dynDir) ;
RENGUIN_WAYLAND_DIR on $(linuxRoot)
	= [ FDirName $(HAIKU_TOP) src libs wayland ] ;
RENGUIN_WAYLAND_CLIENT_DIR on $(linuxRoot) = $(waylandClientDir) ;
RENGUIN_ROOT_CACHE on $(linuxRoot)
	= [ FDirName $(HAIKU_DOWNLOAD_DIR) renguin-linux-root ] ;

actions BuildRenguinLinuxRoot
{
	sh $(2[1]) $(1) "$(HOST_CC)" $(RENGUIN_DYN_DIR) $(2[2]) \
		$(RENGUIN_ROOT_CACHE) $(2[3]) $(RENGUIN_WAYLAND_DIR) \
		$(RENGUIN_WAYLAND_CLIENT_DIR)
}
BuildRenguinLinuxRoot $(linuxRoot) : $(rootInputs) <build>wayland_scanner ;

actions BuildRenguinChromiumRoot
{
	sh $(2[1]) $(1) $(2[2]) $(RENGUIN_ROOT_CACHE) $(RENGUIN_CHROME_PAGES)
}

# Optional: Alpine's Chromium on top of the Linux root (roadmap F-27,
# "Linux Chrome under Renguin"; root/build-chromium-root.sh). About 230 MB
# to download once and 500 MB in the image, so only harness images built
# with RENGUIN_LINUX_CHROMIUM=1 (ce-test.py --linux-chromium) carry it.
local chromiumRoot ;
if $(RENGUIN_LINUX_CHROMIUM) = 1 {
	chromiumRoot = <renguin-linux>renguin-chromium-root.tar.gz ;
	MakeLocate $(chromiumRoot) : $(outputDir) ;
	local chromiumInputs = <renguin-root>build-chromium-root.sh
		<renguin-root>chromium.pins ;
	SEARCH on $(chromiumInputs) = $(rootDir) ;
	local chromePages = <renguin-chrome>index.html ;
	SEARCH on $(chromePages) = [ FDirName $(SUBDIR) chrome ] ;
	Depends $(chromiumRoot) : $(chromiumInputs) $(chromePages) ;
	RENGUIN_CHROME_PAGES on $(chromiumRoot) = [ FDirName $(SUBDIR) chrome ] ;
	RENGUIN_ROOT_CACHE on $(chromiumRoot)
		= [ FDirName $(HAIKU_DOWNLOAD_DIR) renguin-linux-root ] ;
	BuildRenguinChromiumRoot $(chromiumRoot) : $(chromiumInputs) ;
}

local expected = <renguin-linux-src>expected.txt ;
SEARCH on $(expected) = $(linuxDir) ;

# A native program with an IFUNC, built the way Chromium's V8 tools are
# (Chromium R-8): the build host's clang compiles it for Haiku and ld.lld
# links it against Haiku's glue code and libroot (an R_X86_64_IRELATIVE
# relocation); EI_OSABI is then set to 3 (ELFOSABI_GNU), as lld does when
# its inputs use GNU extensions. It must run natively, not under Renguin.
# (Haiku's GCC refuses the ifunc attribute.) Skipped without clang/ld.lld.
actions BuildRenguinIfuncNative
{
	clang --target=x86_64-unknown-haiku -O2 -fPIC -nostdinc \
		-I$(RENGUIN_HEADERS)/glibc -I$(RENGUIN_HEADERS)/posix \
		-I$(RENGUIN_HEADERS) -I$(RENGUIN_HEADERS)/os \
		-I$(RENGUIN_HEADERS)/os/support -I$(RENGUIN_HEADERS)/os/kernel \
		-I$(RENGUIN_GCC_LIB_DIR)/include -c $(2[1]) -o $(1).o
	ld.lld -o $(1) -shared -Bsymbolic --eh-frame-hdr \
		-z max-page-size=0x1000 $(2[2-5]) $(1).o $(2[8]) \
		-L$(RENGUIN_GCC_LIB_DIR) -lgcc $(2[6-7])
	printf '\003' | dd of=$(1) bs=1 seek=7 conv=notrunc status=none
	rm -f $(1).o
}

local ifuncNative ;
local arch = $(TARGET_PACKAGING_ARCH) ;
if $(CE_HARNESS) && $(TARGET_ARCH) = x86_64 {
	ifuncNative = <renguin-native>renguin_ifunc_native ;
	MakeLocate $(ifuncNative) : $(outputDir) ;
	local ifuncSource = <renguin-native>ifunc_native.c ;
	SEARCH on $(ifuncSource) = [ FDirName $(SUBDIR) native ] ;
	local glueBegin = $(HAIKU_EXECUTABLE_BEGIN_GLUE_CODE_$(arch)) ;
	local glueEnd = $(HAIKU_EXECUTABLE_END_GLUE_CODE_$(arch)) ;
	local libroot = $(HAIKU_LIBRARY_NAME_MAP_$(arch)_root) ;
	Depends $(ifuncNative) : $(ifuncSource) $(glueBegin) $(glueEnd)
		$(libroot) ;
	RENGUIN_GCC_LIB_DIR on $(ifuncNative) = $(HAIKU_GCC_LIB_DIR_$(arch)) ;
	RENGUIN_HEADERS on $(ifuncNative) = [ FDirName $(HAIKU_TOP) headers ] ;
	# sources: the C file, 4 begin and 2 end glue objects, libroot
	BuildRenguinIfuncNative $(ifuncNative)
		: $(ifuncSource) $(glueBegin) $(glueEnd) $(libroot) ;
}


Application renguin_test :
	renguin_test.cpp
	: [ TargetLibstdc++ ]
;

if $(CE_HARNESS) && $(TARGET_ARCH) = x86_64 {
	AddFilesToHaikuImage system non-packaged data renguin-tests
		: $(programs) $(expected) $(ifuncNative) ;
	AddFilesToHaikuImage system non-packaged bin ce-tests : renguin_test ;
	ExtractArchiveToHaikuImage system non-packaged compat linux
		: $(linuxRoot) ;
	if $(chromiumRoot) {
		ExtractArchiveToHaikuImage system non-packaged compat linux
			: $(chromiumRoot) ;
	}
}
