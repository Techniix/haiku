SubDir HAIKU_TOP 3rdparty ce tests renguin ;

# Renguin (roadmap F-27): Linux programs run by the renguin personality.
# The Linux test programs (linux/, from Techniix/Renguin's tests/linux/poc)
# are built here with the build host's own compiler, which on the harness
# host is a Linux x86-64 gcc, so no prebuilt binaries are kept in the tree:
#  - the raw ones use no C library (-nostdlib); they carry no Linux marker,
#    so the action sets EI_OSABI to 3 (ELFOSABI_LINUX), as FreeBSD's
#    brandelf does; Linux ignores the byte;
#  - the libc ones are static glibc programs (the host's libc.a), which
#    glibc brands itself (an NT_GNU_ABI_TAG note). They exist only inside
#    harness images, which are never distributed.
# renguin_test (in Haiku) runs them and compares with linux/expected.txt.

local linuxDir = [ FDirName $(SUBDIR) linux ] ;
local outputDir = [ FDirName $(HAIKU_OUTPUT_DIR) ce-renguin-tests ] ;

RENGUIN_RAW_FLAGS = -O2 -ffreestanding -fno-stack-protector -fno-pie
	-nostdlib -static -no-pie -Wl,--build-id=none ;

actions BuildRenguinRawProgram
{
	$(HOST_CC) $(RENGUIN_RAW_FLAGS) -I$(2:D) -o $(1) $(2)
	printf '\003' | dd of=$(1) bs=1 seek=7 conv=notrunc status=none
}

actions BuildRenguinLibcProgram
{
	$(HOST_CC) -O2 $(RENGUIN_LIBC_FLAGS) -o $(1) $(2)
}

rule RenguinLinuxProgram name : source : kind : flags
{
	local target = <renguin-linux>$(name) ;
	local sourceFile = <renguin-linux-src>$(source) ;
	SEARCH on $(sourceFile) = $(linuxDir) ;
	MakeLocate $(target) : $(outputDir) ;
	Depends $(target) : $(sourceFile) ;
	if $(kind) = raw {
		Depends $(target) : <renguin-linux-src>sys.h ;
		BuildRenguinRawProgram $(target) : $(sourceFile) ;
	} else {
		RENGUIN_LIBC_FLAGS on $(target) = $(flags) ;
		BuildRenguinLibcProgram $(target) : $(sourceFile) ;
	}
	return $(target) ;
}

SEARCH on <renguin-linux-src>sys.h = $(linuxDir) ;

local programs ;
for name in hello ebadf enosys exit xmm {
	programs += [ RenguinLinuxProgram $(name) : $(name).S : raw ] ;
}
for name in args mem fileio ids proc threads signals {
	programs += [ RenguinLinuxProgram $(name) : $(name).c : raw ] ;
}
programs += [ RenguinLinuxProgram libc : libc.c : libc : -static ] ;
programs += [ RenguinLinuxProgram libc-pie : libc.c : libc
	: -static-pie -fPIE ] ;
programs += [ RenguinLinuxProgram libc-procfs : libc-procfs.c : libc
	: -static ] ;
for name in pthread libc-signals libc-fs {
	programs += [ RenguinLinuxProgram $(name) : $(name).c : libc
		: -static -pthread ] ;
}

# The Linux root for dynamic programs: Alpine's minirootfs with GNU
# coreutils, the test programs in dyn/ linked against musl and the build
# host's glibc (root/build-root.sh, which documents it). The pinned Alpine
# files are downloaded into the download directory once. The archive is
# extracted into the image's /boot/system/non-packaged/compat/linux, where
# Renguin looks for the Linux root (RENGUIN_LINUX_ROOT).
local rootDir = [ FDirName $(SUBDIR) root ] ;
local dynDir = [ FDirName $(SUBDIR) dyn ] ;
local linuxRoot = <renguin-linux>renguin-linux-root.tar.gz ;
MakeLocate $(linuxRoot) : $(outputDir) ;
local rootInputs = <renguin-root>build-root.sh <renguin-root>alpine.pins ;
SEARCH on $(rootInputs) = $(rootDir) ;
local dynSources = <renguin-dyn>hello.c <renguin-dyn>net.c <renguin-dyn>fds.c ;
SEARCH on $(dynSources) = $(dynDir) ;
local waylandClientDir = [ FDirName $(SUBDIR) dyn-wayland ] ;
local waylandClientSources = <renguin-dyn-wayland>wlclient.c ;
SEARCH on $(waylandClientSources) = $(waylandClientDir) ;
Depends $(linuxRoot) : $(rootInputs) $(dynSources) $(waylandClientSources)
	<build>wayland_scanner ;
RENGUIN_DYN_DIR on $(linuxRoot) = $(dynDir) ;
RENGUIN_WAYLAND_DIR on $(linuxRoot)
	= [ FDirName $(HAIKU_TOP) src libs wayland ] ;
RENGUIN_WAYLAND_CLIENT_DIR on $(linuxRoot) = $(waylandClientDir) ;
RENGUIN_ROOT_CACHE on $(linuxRoot)
	= [ FDirName $(HAIKU_DOWNLOAD_DIR) renguin-linux-root ] ;

actions BuildRenguinLinuxRoot
{
	sh $(2[1]) $(1) "$(HOST_CC)" $(RENGUIN_DYN_DIR) $(2[2]) \
		$(RENGUIN_ROOT_CACHE) $(2[3]) $(RENGUIN_WAYLAND_DIR) \
		$(RENGUIN_WAYLAND_CLIENT_DIR)
}
BuildRenguinLinuxRoot $(linuxRoot) : $(rootInputs) <build>wayland_scanner ;

local expected = <renguin-linux-src>expected.txt ;
SEARCH on $(expected) = $(linuxDir) ;

Application renguin_test :
	renguin_test.cpp
	: [ TargetLibstdc++ ]
;

if $(CE_HARNESS) && $(TARGET_ARCH) = x86_64 {
	AddFilesToHaikuImage system non-packaged data renguin-tests
		: $(programs) $(expected) ;
	AddFilesToHaikuImage system non-packaged bin ce-tests : renguin_test ;
	ExtractArchiveToHaikuImage system non-packaged compat linux
		: $(linuxRoot) ;
}
