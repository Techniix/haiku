#!/bin/sh
# ldconfig for Renga's Flatpak test runtime (org.renga.TestPlatform).
# "flatpak run" regenerates the runtime's ld.so.cache with
# "ldconfig -X -C <file>" before it starts a program. The runtime's only
# programs are static (busybox and the test app), so an empty cache file
# is all that is needed.
while [ $# -gt 0 ]; do
	case "$1" in
		-C) : > "$2"; shift 2 ;;
		*) shift ;;
	esac
done
exit 0
