SubDir HAIKU_TOP 3rdparty ce tests wayland ;

# The Wayland compositor (roadmap F-43 phase C): wayland_test is a native
# Wayland client on Renga's libwayland (socket transport).

include [ FDirName $(HAIKU_TOP) src libs wayland WaylandRules ] ;

UseHeaders [ FDirName $(HAIKU_TOP) headers compatibility gnu ] : true ;
UsePrivateHeaders interface input shared ;
	# WindowInfo.h: the compositor's windows (decorations, Chrome's window);
	# wayland_clients.h: the compositor's client list (Deskbar entries)
SubDirSysHdrs $(LOCATE_SOURCE) ;
SubDirSysHdrs [ FDirName $(HAIKU_TOP) src libs wayland src ] ;
SubDirSysHdrs [ FDirName $(HAIKU_TOP) src libs wayland egl ] ;
SubDirSysHdrs [ FDirName $(HAIKU_TOP) src libs wayland cursor ] ;
SubDirC++Flags -DWL_RENGA_SOCKETS -Wno-missing-field-initializers ;
SubDirCcFlags -DWL_RENGA_SOCKETS ;

local headers = [ WaylandProtocols xdg-shell : c client ]
	[ WaylandProtocolFile wayland-client-protocol.h : wayland.xml
		: client-header ] ;
Depends [ FGristFiles wayland_test.o xdg-shell-protocol.o ] : $(headers) ;

Application wayland_test :
	wayland_test.cpp
	xdg-shell-protocol.c
	: be libgnu.so libwayland-client-renga.so network [ TargetLibstdc++ ]
		# the shared library ports get (package renga_wayland)
;

# The protocols that complete the compositor (2026-11-14 batch).
local protocolTestProtocols = xdg-decoration-unstable-v1
	xdg-output-unstable-v1 fractional-scale-v1 idle-inhibit-unstable-v1
	primary-selection-unstable-v1 pointer-constraints-unstable-v1
	relative-pointer-unstable-v1 cursor-shape-v1 tablet-v2
	xdg-toplevel-icon-v1 xdg-activation-v1 viewporter ;
local protocolTestHeaders = [ WaylandProtocols $(protocolTestProtocols)
	: c client ] ;
Depends [ FGristFiles wayland_protocols_test.o
		$(protocolTestProtocols)-protocol.o ]
	: $(headers) $(protocolTestHeaders) ;

Application wayland_protocols_test :
	wayland_protocols_test.cpp
	xdg-shell-protocol.c
	$(protocolTestProtocols)-protocol.c
	: be libgnu.so libwayland-client-renga.so libwayland-egl-renga.so
		libwayland-cursor-renga.so network [ TargetLibstdc++ ]
;

# linux-dmabuf v4 and wp_linux_drm_syncobj_v1 (Quasar R-18), with memfd
# buffers and CPU-signalled DRM syncobj points.
local gpuSyncProtocols = linux-dmabuf-v1 linux-drm-syncobj-v1 ;
local gpuSyncHeaders = [ WaylandProtocols $(gpuSyncProtocols) : c client ] ;
Depends [ FGristFiles wayland_gpusync_test.o $(gpuSyncProtocols)-protocol.o ]
	: $(headers) $(gpuSyncHeaders) ;

Application wayland_gpusync_test :
	wayland_gpusync_test.cpp
	$(gpuSyncProtocols)-protocol.c
	: be libgnu.so libwayland-client-renga.so network [ TargetLibstdc++ ]
;

if $(CE_HARNESS) && $(TARGET_ARCH) = x86_64 {
	AddFilesToHaikuImage system non-packaged bin ce-tests : wayland_test
		wayland_protocols_test wayland_gpusync_test ;
}
