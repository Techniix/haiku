# Renga test harness job (installed only into harness images,
# as /boot/system/settings/launch/ce-harness). Runs the in-guest test runner
# once the boot volumes are mounted, independently of any desktop session.

job x-vnd.Haiku-CE-harness {
	launch /bin/sh /boot/system/non-packaged/data/ce-harness/runner.sh
	on initial_volumes_mounted
	no_safemode
}

# The tests need the sound card to themselves: on images with a desktop
# (the renga-* profiles), media_server and its add-on server would otherwise
# open the virtio_sound device first and vsnd_test would find it busy. The
# minimum images do not start a media_server anyway.
service x-vnd.Haiku-media_server {
	disabled
}
