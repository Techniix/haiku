#!/bin/sh
# selftest: checks of the tools/renga scripts themselves.
#
# Usage: tools/renga/selftest
#
# 1. worktree-hook: renga-guard run the way the pre-push hook runs it in a
#    linked worktree (GIT_DIR set, GIT_WORK_TREE not) finds its
#    protected-paths list. Before lib.sh dropped GIT_DIR it looked for
#    <worktree>/tools/renga/tools/renga/protected-paths and blocked every
#    push from a worktree.
# 2. no-results-not-pass: renga-test reports a ce-test.py run that wrote no
#    results (a command-line error) as failed, never as passed (0 or 2).
#
# 3. image-identity: renga-image (--no-build, against a temporary
#    renga-builds clone and a stand-in image) stops before it changes the
#    clone when the clone has no commit identity: no build branch, nothing
#    staged, still on main. Before, the commit failed after the parts were
#    staged on the new branch.
# 4. image-revision: build.txt's revision line names "(Renga <commit>
#    <date>)" once, whether the revision file already ends in it (the
#    normal case, which gave it twice before) or not.
#
# Creates a temporary detached worktree of HEAD (or of RENGA_SELFTEST_REV,
# to show a check failing on older scripts) and removes it again.
# Exit status: 0 when every check passed, 1 otherwise.
set -eu
# shellcheck source=tools/renga/lib.sh
. "$(dirname "$0")/lib.sh"

case ${1:-} in
-h|--help) renga_usage; exit 0 ;;
esac

failures=0
check() {
	if [ "$2" = 0 ]; then
		echo "PASS $1"
	else
		echo "FAIL $1: $3"
		failures=$((failures + 1))
	fi
}

base=$(git rev-parse "${RENGA_SELFTEST_REV:-HEAD}")
dir=$(mktemp -d "${TMPDIR:-/tmp}/renga-selftest.XXXXXX")
trap 'git worktree remove --force "$dir/wt" >/dev/null 2>&1 || true; rm -rf "${dir:?}"' EXIT
git worktree add -q --detach "$dir/wt" "$base"
gitdir=$(git -C "$dir/wt" rev-parse --absolute-git-dir)
out=$(cd "$dir/wt" && GIT_DIR=$gitdir tools/renga/renga-guard --head "$base" \
	"$base" 2>&1) && status=0 || status=$?
case $out in
*"missing "*protected-paths*) status=1 ;;
esac
check worktree-hook "$status" "$(echo "$out" | tail -n 1)"

# 2. no-results-not-pass: a ce-test.py command-line error (here an unknown
#    option) writes no results and must not read as "selection passed"
#    (exit 2). Before batch 14 argparse's status 2 came through unchanged.
#    Needs a configured output directory (renga-test checks it); skipped
#    without one.
if [ -f "$RENGA_OUTPUT/build/BuildConfig" ]; then
	out=$(cd "$dir/wt" && HAIKU_OUTPUT_DIR=$RENGA_OUTPUT tools/renga/renga-test \
		epoll --no-such-option 2>&1) && status=0 || status=$?
	case $status in
	0|2) check no-results-not-pass 1 "renga-test exited $status for a run that never started (want a failure: not 0 or 2)" ;;
	*) check no-results-not-pass 0 "" ;;
	esac
else
	echo "SKIP no-results-not-pass: $RENGA_OUTPUT is not configured"
fi

# 3./4. renga-image's dry parts: a bare "origin" with a main branch, a
#    clone of it, and an output directory with a small stand-in image and
#    revision file. Global and system git config are left out, so only the
#    clone's own config can supply an identity.
im=$dir/image
mkdir -p "$im/out/build" "$im/home"
head -c 300000 /dev/urandom > "$im/out/renga-anyboot.iso"
iso_git() {
	env -u GIT_AUTHOR_NAME -u GIT_AUTHOR_EMAIL -u GIT_COMMITTER_NAME \
		-u GIT_COMMITTER_EMAIL -u EMAIL HOME="$im/home" GIT_CONFIG_NOSYSTEM=1 \
		GIT_CONFIG_GLOBAL=/dev/null "$@"
}
iso_git git init -q --bare -b main "$im/origin.git"
iso_git git clone -q "$im/origin.git" "$im/builds" 2>/dev/null
iso_git git -C "$im/builds" -c user.name=selftest -c user.email=selftest@invalid \
	commit -q --allow-empty -m main
iso_git git -C "$im/builds" push -q origin main
run_image() { # <name> <revision file text>
	printf '%s\n' "$2" > "$im/out/build/haiku-revision"
	(cd "$dir/wt" && iso_git env HAIKU_OUTPUT_DIR="$im/out" tools/renga/renga-image \
		--no-build --builds "$im/builds" "$1" 2>&1)
}
out=$(run_image 2026.11.28-noident "hrev60381+604 (Renga cc8f520b 2026-11-28)") \
	&& status=0 || status=$?
state="exit $status, branch $(git -C "$im/builds" branch --show-current),"
state="$state status '$(git -C "$im/builds" status --porcelain | head -n 1)'"
if [ "$status" != 0 ] && echo "$out" | grep -q "no commit identity" \
	&& [ "$(git -C "$im/builds" branch --show-current)" = main ] \
	&& [ -z "$(git -C "$im/builds" status --porcelain)" ] \
	&& ! git -C "$im/builds" rev-parse -q --verify refs/heads/build/2026.11.28-noident >/dev/null; then
	check image-identity 0 ""
else
	check image-identity 1 "with no identity: $state; $(echo "$out" | tail -n 1)"
fi
# Independent of check 3: older scripts left the parts staged.
git -C "$im/builds" reset -q --hard && git -C "$im/builds" clean -qfdx
git -C "$im/builds" switch -q main
git -C "$im/builds" config user.name selftest
git -C "$im/builds" config user.email selftest@invalid
status=0
for case in "with:hrev60381+604 (Renga cc8f520b 2026-11-28)" "without:hrev60381+604"; do
	n=2026.11.28-rev-${case%%:*}
	out=$(run_image "$n" "${case#*:}") || { status=1; detail="$n: $(echo "$out" | tail -n 1)"; break; }
	line=$(git -C "$im/builds" show "build/$n:build.txt" | grep '^revision:')
	case $line in
	*"(Renga "*"(Renga "*|*[!")"]) status=1; detail="$n: $line"; break ;;
	esac
done
check image-revision "$status" "${detail:-}"

[ $failures = 0 ]
