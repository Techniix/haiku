# Renga (roadmap F-51): after login, a notification for each kernel crash
# report crash_collector saved and nobody has seen yet; clicking it opens
# the report in System logs. Only on images that have the application.
target desktop {
	job x-vnd.Renga-SystemLogs-notify {
		launch /system/apps/SystemLogs --notify
		if file_exists /system/apps/SystemLogs
		on initial_volumes_mounted
		no_safemode
	}
}
