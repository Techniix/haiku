resource app_signature "application/x-vnd.LinuxKPI-Manager";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "LinuxKPI Manager",
	long_info = "Manage and diagnose LinuxKPI drivers."
};
