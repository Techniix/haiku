resource app_signature "application/x-vnd.Renga-Welcome";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "Welcome",
	long_info = "Welcome to Renga: network, drivers, software, Linux programs, gamepads and the shortcut key, on the first login"
};

resource file_types message {
	"types" = "application/x-vnd.Be-elfexecutable"
};
