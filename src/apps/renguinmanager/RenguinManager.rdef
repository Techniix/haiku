resource app_signature "application/x-vnd.Renga-RenguinManager";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "Renguin Manager",
	long_info = "Renguin Manager: Linux programs on Renga, the Linux root, its packages and diagnostics"
};

resource file_types message {
	"types" = "application/x-vnd.Be-elfexecutable"
};
