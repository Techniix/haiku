SubDir HAIKU_TOP src apps systemlogs ;

# Renga (roadmap F-51): the system log viewer with the crash reports. It
# moves into the Control Panel's System section later (F-28).

UsePrivateHeaders shared ;
UseBuildFeatureHeaders zlib ;

Includes [ FGristFiles ReportArchive.cpp ]
	: [ BuildFeatureAttribute zlib : headers ] ;

Application SystemLogs :
	SystemLogs.cpp
	ReportArchive.cpp
	: be localestub [ TargetLibstdc++ ]
		[ BuildFeatureAttribute zlib : library ]
	: SystemLogs.rdef
;

# The background server that shows a notification for each new kernel
# crash report after login (data/launch/user_crash_reports); installed in
# system/servers.
Application crash_report_notifier :
	CrashReportNotifier.cpp
	: be localestub [ TargetLibstdc++ ]
	: CrashReportNotifier.rdef
;

DoCatalogs crash_report_notifier :
	x-vnd.Renga-CrashReportNotifier
	:
	CrashReportNotifier.cpp
;

DoCatalogs SystemLogs :
	x-vnd.Renga-SystemLogs
	:
	SystemLogs.cpp
;
