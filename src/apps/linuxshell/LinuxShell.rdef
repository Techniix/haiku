resource app_signature "application/x-vnd.Renga-LinuxShell";

resource app_flags B_MULTIPLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "Linux shell",
	long_info = "Linux shell ©2026 Renga contributors. Opens Terminal with "
		"Renguin's Linux shell."
};
