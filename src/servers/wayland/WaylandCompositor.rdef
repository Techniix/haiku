resource app_signature "application/x-vnd.Renga-WaylandCompositor";

// A background server: its windows belong to the Wayland programs they
// show, so the compositor itself is not listed in Deskbar; one per session.
resource app_flags B_BACKGROUND_APP | B_EXCLUSIVE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "Wayland compositor",
	long_info = "Shows Wayland programs, native and Linux, as Renga windows"
};

resource file_types message {
	"types" = "application/x-vnd.Be-elfexecutable"
};
