SubDir HAIKU_TOP src servers dbus ;

# Renga's D-Bus session bus (roadmap F-43 phase D): the message bus, and
# the notification, UPower, portal (settings, open URI) and Secret Service
# services inside it, for Linux programs under Renguin and ported programs.

UsePrivateHeaders device ;

Application session_bus :
	main.cpp
	DBusMessage.cpp
	SessionBus.cpp
	Services.cpp
	: be bnetapi network [ TargetLibstdc++ ]
	: session_bus.rdef SessionBusIcon.rdef
;

# The approval question as a normal application (it gets the keyboard
# focus, which session_bus, a background application, does not).
Application session_bus_prompt :
	secret_prompt.cpp
	: be [ TargetLibstdc++ ]
	: secret_prompt.rdef SessionBusIcon.rdef
;
