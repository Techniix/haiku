resource app_signature "application/x-vnd.Renga-SessionBusPrompt";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "Saved passwords prompt",
	long_info = "Asks whether a program may use the saved passwords "
		"(Renga's Secret Service)."
};
