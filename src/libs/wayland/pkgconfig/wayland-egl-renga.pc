# Renga's libwayland-egl (wl_egl_window), package renga_wayland.
# Installed as develop/lib/pkgconfig/wayland-egl-renga.pc.
prefix=/boot/system
libdir=${prefix}/develop/lib
includedir=${prefix}/develop/headers/renga_wayland

Name: wayland-egl-renga
Description: Frontend wayland-egl library, Renga build
Version: 18.1.0
Requires: wayland-client-renga
Cflags: -I${includedir}
Libs: -L${libdir} -lwayland-egl-renga
