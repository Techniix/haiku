# Renga's socket-transport libwayland (client side), package renga_wayland.
# Installed as data/renga_wayland/pkgconfig/wayland-client.pc, for PKG_CONFIG_PATH.
prefix=/boot/system
libdir=${prefix}/develop/lib
includedir=${prefix}/develop/headers/renga_wayland

Name: wayland-client
Description: Wayland client library, Renga socket transport
Version: 1.21.90
Cflags: -I${includedir} -DWL_RENGA_SOCKETS
Libs: -L${libdir} -lwayland-client-renga
