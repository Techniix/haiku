SubDir HAIKU_TOP src bin lkpictl ;

# Command-line front end of liblinuxkpi_manage (built in
# src/apps/linuxkpimanager).

UsePrivateHeaders shared system linuxkpi ;
UsePrivateSystemHeaders ;
SubDirHdrs $(HAIKU_TOP) src apps linuxkpimanager core ;

Application lkpictl :
	lkpictl.cpp
	: liblinuxkpi_manage.a be bnetapi network [ TargetLibstdc++ ] [ TargetLibsupc++ ]
	;
