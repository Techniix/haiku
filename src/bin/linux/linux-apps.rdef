 *
 * linux-apps: the helper for Linux programs (Deskbar entries, Open with,
 * badges, themes) and the program that opens AppImages: Tracker hands it
 * the files on the command line (B_ARGV_ONLY). Its icon is the Renguin
 * badge (3rdparty/ce/tools/make_renguin_badge_icon.py --rdef).
 */

resource app_signature "application/x-vnd.Renga-linux-apps";

resource app_flags B_MULTIPLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "linux-apps",
	long_info = "Linux programs in Renga's Deskbar, Tracker and Open with; AppImages"
};

resource file_types message {
	"types" = "application/x-appimage"
};

