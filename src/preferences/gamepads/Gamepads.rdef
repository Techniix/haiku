resource app_signature "application/x-vnd.Renga-Gamepads";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "Gamepads",
	long_info = "Gamepad preferences and overlay for Renga"
};

resource file_types message {
	"types" = "application/x-vnd.Be-elfexecutable"
};
