SubDir HAIKU_TOP src add-ons kernel personalities renguin ;

UsePrivateKernelHeaders ;
UsePrivateHeaders system ;

# Linux ABI binaries are x86-64 only for now.
if $(TARGET_ARCH) = x86_64 {
	KernelAddon renguin :
		renguin.cpp
		loader.cpp
		errno.cpp
		syscall.cpp
		usermem.cpp
		path.cpp
		mem.cpp
		file.cpp
		tty.cpp
		misc.cpp
		process.cpp
		exec.cpp
		threads.cpp
		futex.cpp
		signal.cpp
		procfs.cpp
		fsops.cpp
		poll.cpp
		sysinfo.cpp
		net.cpp
		fds.cpp
	;
}
