
resource(0, "BEOS:TYPE") #'MIMS' "application/x-vnd.Be-meta-mime";

resource(1, "META:TYPE") "application/x-appimage";

resource(2, "META:S:DESC") #'MSDC' "AppImage";

resource(3, "META:L:DESC") #'MLDC' "Linux program packed as an AppImage (runs with Renguin)";

/* an ELF file with the AppImage magic "AI" (type 1 or 2) at offset 8;
   ahead of the ELF executable rule (0.90) */
resource(4, "META:SNIFF_RULE") "0.95 (0x7f454c46) [8] (0x4149)";

resource(5, "META:PREF_APP") #'MSIG' "application/x-vnd.Renga-linux-apps";

resource(6, "META:EXTENS") message(234) {
	"extensions" = "AppImage",
	"extensions" = "appimage",
	"type" = "application/x-appimage"
};
